# ---- dependencies ----
node_modules/
.pnpm-store/

# ---- build output that is NOT shipped ----
dist/
build/
*.tsbuildinfo

# ---- editor / OS noise ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- logs & temp ----
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
.cache/

# ---- local secrets / machine-specific ----
.env
.env.*
!.env.example
secrets.local.json
plugin.config.json

# ---- Obsidian local state (never commit) ----
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.trash/

# ---- verification / screenshot artifacts ----
data/verify-output/
data/shots*/
data/_chrome*/
*.png.tmp

# ---- 本地效果图素材（不上传；README 引用的是 docs/images 下的压缩版）----
img插件介绍图/

# ---- 本地操作指南（内部文档，不上传）----
README操作指南.md

# ---- 发布用压缩包（手动打包给用户下载，不进版本库）----
*.zip

# ---- 自述备份文档（本地留存，不上传）----
README-bak*.md
README-archived*.md
docs/README-bak*.md
docs/README-archived*.md
